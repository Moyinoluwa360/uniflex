# Uniflex — environment variables
#
# Copy this file to `.env` (same folder) and fill in real values there.
# `.env` is gitignored and must never be committed — this file (.env.example)
# is the only one that should ever be tracked in git, and it must only ever
# hold placeholder names, never real keys or secrets.
#
# Phase 0 does not wire any of these up to real services yet — the app runs
# entirely on mocked/local data. This file exists now so later phases can
# fill in real values without changing how config is loaded.

# Supabase — backend database, auth, storage
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Paystack — payments
PAYSTACK_PUBLIC_KEY=

# Termii — SMS / OTP delivery
TERMII_API_KEY=

# Firebase — push notifications / analytics
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Google Maps — rider tracking, delivery routing, campus maps
GOOGLE_MAPS_API_KEY=
