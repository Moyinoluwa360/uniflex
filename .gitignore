# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/app/build/
/android/build/

# Machine-specific local SDK paths — regenerated per developer machine
/android/local.properties
/android/**/local.properties

# Environment variables — real secrets live only in a local .env,
# never in .env.example (which stays tracked as the placeholder template)
#
# IMPORTANT: .env is bundled into the app binary (see pubspec.yaml assets),
# so it may only ever hold values that are safe to ship to a device:
# the Supabase URL + anon key, the Paystack PUBLIC key, Firebase client
# config, and the Maps key. Server-side secrets (service role key, Termii,
# Paystack secret key) belong in .env.tooling or Supabase Edge Function
# secrets — never here.
.env
.env.tooling
.env.backup-preaudit
.env.*.local

# Local Windows helper files
yes.txt

# Supabase CLI scratch — per-machine link state (project ref, pooler URL,
# tool versions) that the CLI rewrites on every command. Not secret, but it
# churns constantly and differs per developer.
supabase/.temp/

# Coverage output
coverage/
